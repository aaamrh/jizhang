# 复制为 .env 后修改。
# 后端地址。安卓模拟器访问电脑本机：10.0.2.2；真机：填电脑的局域网 IP，例如 http://192.168.1.5:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# 模拟支付：只在测试环境设 true（后端也要设 ENABLE_MOCK_PAY=true），正式包必须是 false
EXPO_PUBLIC_MOCK_PAY=false

# 微信登录：开放平台"移动应用"的 AppID 和 iOS 通用链接。不填则登录页不显示微信登录
EXPO_PUBLIC_WECHAT_APP_ID=
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=
