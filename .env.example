# 复制为 .env 再改。.env 不要提交到 git。
DB_PASSWORD=改成一个长随机密码
JWT_SECRET=至少32位的随机字符串
ADMIN_PASSWORD=后台登录密码（至少8位）

# 对外访问地址（https 域名），用于生成家庭邀请链接
PUBLIC_URL=http://localhost:3000

# 微信登录：open.weixin.qq.com 创建"移动应用"后得到。不填则微信登录不可用
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Apple 登录：App 的 Bundle ID。不填则 Apple 登录不可用
APPLE_BUNDLE_ID=

# 模拟支付，只在测试环境打开，正式环境必须是 false
ENABLE_MOCK_PAY=false

# 测试环境把短信验证码直接返回给 App（没接短信服务时也能登录）。正式环境必须是 false
SMS_DEV_ECHO=false

# 照片存储：local = 存在服务器磁盘（docker 卷 files）；s3 = 阿里云 OSS / 腾讯云 COS（S3 兼容接口）
STORAGE_DRIVER=local
# 用 s3 时填写，例如阿里云 OSS：S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com  S3_REGION=oss-cn-hangzhou
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# 放在 nginx 等反向代理后面时改成 true
TRUST_PROXY=false
