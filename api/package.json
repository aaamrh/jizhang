{
  "name": "zhangfang-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
